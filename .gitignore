.state-*/
data/
runs/
voices/
checkpoints/
profiles/*.yaml
!profiles/example-*.yaml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/

# Editors / OS
*.swp
.DS_Store
