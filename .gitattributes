# Auto detect text files and perform LF normalization
* text=auto

# This repo runs on Linux and on Windows. The POSIX entry points must be LF
# whatever the local autocrlf setting is, or the shebang line breaks with
# "bad interpreter: /bin/sh^M" after cloning.
run             text eol=lf
setup           text eol=lf
*.sh            text eol=lf
*.py            text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.csv           text eol=lf

# The mirror image, and not cosmetic: cmd.exe parses a batch file with LF-only
# line endings by eating the first character of every line, so `rem` runs as
# `m` and the script fails in a way that looks nothing like a newline problem.
*.cmd           text eol=crlf

# Binary-ish artefacts that must never be normalized.
*.onnx          binary
*.ckpt          binary
*.pt            binary
*.wav           binary
*.f32           binary
