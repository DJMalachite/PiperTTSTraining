#!/bin/sh
# Entry point for everything in this repo.
#
#   ./run              interactive menu
#   ./run setup        install toolchain + piper1-gpl
#   ./run doctor       diagnose the environment
#   ./run dataset      build a dataset from one audio file
#   ./run train        train
#   ./run --help       full command list
#
# Prefers the project venv; falls back to a system python only so that a fresh
# clone can bootstrap itself. Anything past `setup` needs the venv.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$here"

# PIPERTRAINER_ENV names a second installed environment: .venv-<name> and
# .state-<name> instead of .venv and .state. Unset — the normal case — keeps the
# historic layout exactly. See src/pipertrainer/paths.py and docs/BC250.md.
# Refused rather than sanitised: paths.py runs the name through the same slug
# the voice names use, and a name this accepts is one that slug leaves alone, so
# both sides always agree on the directory.
suffix=""
if [ -n "${PIPERTRAINER_ENV:-}" ]; then
    case "$PIPERTRAINER_ENV" in
        *[!A-Za-z0-9._-]* | [!A-Za-z0-9]* | *[!A-Za-z0-9])
            echo "error: PIPERTRAINER_ENV must start and end with a letter or" >&2
            echo "       digit and contain only letters, digits, '.', '_', '-'" >&2
            echo "       (got: $PIPERTRAINER_ENV)" >&2
            exit 2
            ;;
    esac
    suffix="-$PIPERTRAINER_ENV"
fi

# Persisted environment (e.g. HSA_OVERRIDE_GFX_VERSION) discovered by setup.
if [ -f ".state$suffix/env.sh" ]; then
    # shellcheck disable=SC1091
    . "./.state$suffix/env.sh"
fi

PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
# Unbuffered so streamed subprocess output interleaves correctly in a log.
PYTHONUNBUFFERED=1
export PYTHONUNBUFFERED

if [ -x ".venv$suffix/bin/python" ]; then
    exec ".venv$suffix/bin/python" -m pipertrainer "$@"
fi

for candidate in python3.13 python3.12 python3.11 python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
        exec "$candidate" -m pipertrainer "$@"
    fi
done

echo "error: no python interpreter found on PATH (need 3.11+)" >&2
exit 1
